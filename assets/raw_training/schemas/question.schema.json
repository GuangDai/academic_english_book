{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-english-training.local/schemas/question.schema.json",
  "title": "Academic English Training Question Schema V2.0",
  "version": "2.0.0",
  "type": "object",
  "required": [
    "question_id",
    "day_id",
    "stage",
    "type",
    "difficulty",
    "prompt",
    "context",
    "options",
    "focus_word_ids",
    "grammar_ids",
    "prerequisite_ids",
    "scene",
    "register",
    "answer_format",
    "constraints",
    "max_score"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^Q_D[0-9]{4}_[0-9]{2}$"
    },
    "day_id": {
      "type": "string",
      "pattern": "^day_[0-9]{4}$"
    },
    "stage": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "word_recall_and_form",
        "collocation_practice",
        "contextual_choice_and_synonym",
        "word_replacement",
        "phrase_and_expression_replacement",
        "sentence_rewriting",
        "ch_to_en_translation",
        "logical_cohesion_and_paragraph",
        "active_and_passive_voice",
        "independent_micro_writing"
      ]
    },
    "type_zh": {
      "type": "string",
      "enum": [
        "单词主动回忆和词形",
        "常见词汇搭配",
        "语境选词与近义词辨析",
        "单词替换",
        "词组与表达替换",
        "句子改写",
        "中译英与主动表达",
        "逻辑衔接和语篇组织",
        "主动与被动语态",
        "独立微型写作"
      ]
    },
    "difficulty": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "training_objective": {
      "type": "string",
      "minLength": 5
    },
    "prompt": {
      "type": "string",
      "minLength": 10
    },
    "context": {
      "type": "string",
      "minLength": 5
    },
    "options": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "focus_word_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^V[0-9]{5}$"
      }
    },
    "grammar_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^G[0-9]{3}$"
      }
    },
    "expression_pattern_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EP[0-9]{3}$"
      }
    },
    "prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scene": {
      "type": "string"
    },
    "register": {
      "type": "string",
      "enum": [
        "formal_academic",
        "general_academic",
        "technical_specialized",
        "spoken_academic",
        "neutral_academic"
      ]
    },
    "answer_format": {
      "type": "string",
      "enum": [
        "single_word_or_form",
        "collocation_phrase",
        "single_choice_A_B_C_D",
        "word_or_phrase_substitution",
        "full_sentence_rewrite",
        "english_sentence_translation",
        "paragraph_or_cohesion_analysis",
        "voice_transformation_and_justification",
        "short_academic_paragraph"
      ]
    },
    "is_active_output": {
      "type": "boolean"
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "max_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  }
}