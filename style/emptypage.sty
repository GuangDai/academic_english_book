%%
%% Package `emptypage'
%% Ensures empty pages created by \cleardoublepage have truly empty headers and footers.
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{emptypage}[2010/05/30 v1.2 Emptypage package (EG)]
\DeclareOption{plain}{\def\emptypage@pagestyle{plain}}
\DeclareOption{empty}{\def\emptypage@pagestyle{empty}}
\ExecuteOptions{empty}
\ProcessOptions\relax
\def\cleardoublepage{%
  \clearpage
  \if@twoside
    \ifodd\c@page
    \else
      \thispagestyle{\emptypage@pagestyle}%
      \hbox{}%
      \newpage
      \if@twocolumn
        \hbox{}%
        \newpage
      \fi
    \fi
  \fi
}
\endinput
